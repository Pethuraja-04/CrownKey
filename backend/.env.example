# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/realestate?schema=public"

# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- Auth ---
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-another-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
PUBLIC_BASE_URL=http://localhost:4000

# --- Rate limits ---
INQUIRY_WINDOW_MIN=60
INQUIRY_MAX_PER_WINDOW=5

# --- AI Chatbot (Groq) ---
# Get a free key at https://console.groq.com/keys  (no credit card required)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CHAT_MAX_PER_HOUR=40
